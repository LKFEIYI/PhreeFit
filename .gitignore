# Test files and generated distributions
/test/
/unit_test/
/dist/
/build/
/benchmarks/

# Local settings and generated JSON data
*.json

# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Python test, type-checker, linter, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Python packaging and local compiled extensions
*.egg-info/
.eggs/
*.so
*.pyd

# IPhreeqc out-of-source build trees (keep the source tree trackable)
/iphreeqc/**/_build/
/iphreeqc/**/build/
/iphreeqc/**/cmake-build-*/

# macOS metadata
.DS_Store

# Local IDE and editor settings
.idea/
.vscode/
